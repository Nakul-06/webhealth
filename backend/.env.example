# Google Cloud Platform Configuration
PORT=8080
NODE_ENV=development

# Set to false when ready to connect to live GCP credentials
USE_MOCK_GCP=true

# GCP Project ID (from Google Cloud Console)
GCP_PROJECT_ID=webhealth-gcp-demo

# Path to Service Account JSON key (leave empty if using mock or default credentials)
GOOGLE_APPLICATION_CREDENTIALS=

# Pub/Sub Topics
PUBSUB_TOPIC_NAME=dead-link-tasks
PUBSUB_SUBSCRIPTION_NAME=dead-link-tasks-sub

# Firestore Collections
FIRESTORE_SCANS_COLLECTION=scans

# Crawler Defaults
MAX_LINKS=50
MAX_DEPTH=2
REQUEST_TIMEOUT_MS=10000
