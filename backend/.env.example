# WebHealth Environment Configuration
PORT=8080
NODE_ENV=development

# Azure Cloud Configuration (Leave blank for automatic sandbox emulation)
AZURE_RESOURCE_GROUP=rg-webhealth
AZURE_LOCATION=eastus

# Azure Service Bus
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_QUEUE_NAME=dead-link-tasks

# Azure Cosmos DB (NoSQL)
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_DATABASE_NAME=webhealth-db

# Crawler Tuning Defaults
MAX_LINKS=50
MAX_DEPTH=2
REQUEST_TIMEOUT_MS=10000
